# Port of the editor and the overlays (http://localhost:3100)
PORT=3100

# Password for the editor. Empty = no sign-in, and then only this PC can open the editor.
ADMIN_PASSWORD=
# ADMIN_USER=admin

# Where Rocket League's Stats API listens. Only change it if the game runs on another PC.
# RL_HOST=127.0.0.1
# RL_PORT=49123

# Demo mode: simulated matches and sample data, nothing is saved (same as `npm run demo`)
# DEMO=1
